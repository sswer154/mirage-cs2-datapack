# 剩余时间精确到 0.01 秒；百分秒 0..9 时补一个 0
execute if score #defuse_rem cs2_counts matches 0..9 run tellraw @a[scores={cs2_inmatch=1}] [{"selector":"@a[tag=cs2_last_defuser]","color":"yellow"},{"text":" 在炸弹爆炸前 ","color":"gray"},{"score":{"name":"#defuse_sec","objective":"cs2_counts"},"color":"aqua"},{"text":".0","color":"aqua"},{"score":{"name":"#defuse_rem","objective":"cs2_counts"},"color":"aqua"},{"text":" 秒拆除了炸弹。","color":"gray"}]
execute if score #defuse_rem cs2_counts matches 10..99 run tellraw @a[scores={cs2_inmatch=1}] [{"selector":"@a[tag=cs2_last_defuser]","color":"yellow"},{"text":" 在炸弹爆炸前 ","color":"gray"},{"score":{"name":"#defuse_sec","objective":"cs2_counts"},"color":"aqua"},{"text":".","color":"aqua"},{"score":{"name":"#defuse_rem","objective":"cs2_counts"},"color":"aqua"},{"text":" 秒拆除了炸弹。","color":"gray"}]
